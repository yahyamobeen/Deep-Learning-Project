# frontend/.env.local.example  →  copy to frontend/.env.local
# All vars exposed to the browser MUST be prefixed with NEXT_PUBLIC_

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/translate/ws

# Optional — only if you wire up a 3rd-party avatar service
NEXT_PUBLIC_READY_PLAYER_ME_SUBDOMAIN=
