# gateway/.env.example  →  copy to gateway/.env

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Downstream ML service ─────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── Auth ──────────────────────────────────────────────────
# Generate locally:  openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-string
JWT_EXPIRES_IN=7d

# ── Postgres ──────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
#
# • Local docker-compose:
DATABASE_URL=postgres://signbridge:signbridge_dev@localhost:5432/signdb
#
# • Native Postgres on Windows (default postgres user):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/signdb
#
# • Supabase / Neon / Railway (managed):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_SSL=false

# ── Misc ──────────────────────────────────────────────────
MAX_UPLOAD_MB=25
FRONTEND_URL=http://localhost:3000
