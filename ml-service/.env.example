# ml-service/.env.example  →  copy to ml-service/.env

# Server
HOST=0.0.0.0
PORT=8000

# Hugging Face (REQUIRED to download T5 / Whisper weights the first time)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_HOME=./.hf_cache

# Whisper — choose one
#   "local" = run openai-whisper locally (no API key needed)
#   "openai"= call OpenAI's hosted Whisper (needs OPENAI_API_KEY)
WHISPER_MODE=local
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
OPENAI_API_KEY=

# Model paths (relative to ml-service/)
SIGN_MODEL_PATH=models/sign_transformer.pt
GLOSS_VOCAB_PATH=models/gloss_vocab.json
T5_MODEL_DIR=models/t5_text2gloss
REFERENCE_SIGNS_PATH=models/reference_signs.json

# Inference
DEVICE=cpu                   # cpu | cuda
MAX_VIDEO_MB=25
NUM_FRAMES=32

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
