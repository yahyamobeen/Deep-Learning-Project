# Copy to `.env` (kept out of git). The Flutter app loads this via flutter_dotenv.
# Point this at your deployed gateway. For local dev with `flutter run`, use
# 10.0.2.2 (Android emulator's loopback to host) or your laptop's LAN IP.
GATEWAY_URL=http://10.0.2.2:4000
ML_SERVICE_URL=http://10.0.2.2:8000
