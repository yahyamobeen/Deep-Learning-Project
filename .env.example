# ─────────────────────────────────────────────────────────────────
#  Root .env.example — copy to `.env` and fill in real values.
#  This is the single source of truth; per-service .env files
#  (gateway/.env, ml-service/.env, frontend/.env.local) mirror these.
# ─────────────────────────────────────────────────────────────────

# ===== Internal service URLs =====
ML_SERVICE_URL=http://localhost:8000
GATEWAY_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ===== Database =====
# Local Postgres (use docker-compose) OR a Supabase/Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/signdb

# ===== Auth =====
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-string
JWT_EXPIRES_IN=7d

# ===== Hugging Face (REQUIRED for downloading T5/Whisper models) =====
# Get from: https://huggingface.co/settings/tokens   (free, "Read" scope is enough)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Weights & Biases (OPTIONAL — experiment tracking on Colab) =====
# Get from: https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=sign-language-translator
WANDB_ENTITY=

# ===== Kaggle (OPTIONAL — needed if you fetch datasets via kaggle CLI) =====
# Get from: kaggle.com → Account → Create New API Token (downloads kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=

# ===== OpenAI (OPTIONAL — only if you choose hosted Whisper instead of local) =====
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===== Object storage (OPTIONAL — for uploading sign clips / model artefacts) =====
# AWS S3 OR self-hosted MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sign-clips
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ===== Redis (OPTIONAL — session cache, rate limit) =====
REDIS_URL=redis://localhost:6379

# ===== Frontend public vars (must start with NEXT_PUBLIC_) =====
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/translate/ws

# ===== Misc =====
NODE_ENV=development
LOG_LEVEL=info
