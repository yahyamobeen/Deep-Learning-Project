# training/.env.example
# These go into the FIRST cell of each Colab notebook, e.g.:
#   import os
#   os.environ['HF_TOKEN'] = '...'
#   os.environ['WANDB_API_KEY'] = '...'

# Hugging Face (required to download T5/Whisper inside Colab)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases — experiment tracking (optional but recommended)
WANDB_API_KEY=
WANDB_PROJECT=sign-language-translator

# Kaggle — only if you fetch How2Sign / PHOENIX via kaggle CLI
KAGGLE_USERNAME=
KAGGLE_KEY=

# Drive folder where artefacts are saved (already used in notebooks)
DRIVE_BASE=/content/drive/MyDrive/dl_project
